# 豆包语音控制台 → API Key 管理
SPEECH_API_KEY=
# 火山方舟控制台 → API Key 管理
ARK_API_KEY=
ARK_MODEL=doubao-seed-2-1-pro-260915
SPEECH_RESOURCE_ID=volc.seedasr.sauc.duration
# 可选：两把服务 Key 属于同一账号时，配置该账号的只读管理凭证
QUOTA_AK=
QUOTA_SK=
SPEECH_QUOTA_PROJECT=default
# 若服务 Key 分属不同账号，分别使用 SPEECH_QUOTA_AK/SK、ARK_QUOTA_AK/SK
# 使用 ep- 接入点时设置 ARK_QUOTA_MODEL 为其基础模型名称
