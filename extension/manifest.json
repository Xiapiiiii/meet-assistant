{
  "manifest_version": 3,
  "name": "Meet 会议助手",
  "version": "1.3.2",
  "options_ui": {"page":"options.html","open_in_tab":true},
  "minimum_chrome_version": "116",
  "description": "会议实时双语字幕与中译英发言",
  "key": "",
  "permissions": [
    "sidePanel"
  ],
  "host_permissions": [
    "https://meet.google.com/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "action": {
    "default_title": "打开会议助手"
  },
  "side_panel": {
    "default_path": "panel.html"
  }
}
